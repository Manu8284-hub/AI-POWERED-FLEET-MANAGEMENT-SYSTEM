{
  "name": "fleetiq-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "FleetIQ — AI-powered bus fleet optimisation dashboard (React 19 + Vite).",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "train": "python backend/train.py",
    "api": "python -m uvicorn backend.app:app --port 8000",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run api\" \"npm run dev\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.0",
    "vite": "^8.2.1"
  }
}
